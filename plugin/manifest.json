{
  "manifest_version": 3,
  "name": "Hayase Recent Episodes",
  "version": "0.6.0",
  "description": "Customize Hayase Home sections and browse recently aired anime episodes with poster and hover previews.",
  "homepage_url": "https://github.com/fav-devs/hayase-recent-episodes",
  "permissions": ["storage"],
  "host_permissions": ["https://tsuzuki.top/*", "https://graphql.anilist.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://hayase.app/*"],
    "js": ["home-layout.js", "playback.js", "history.js", "release-cards.js", "content.js"],
    "run_at": "document_idle"
  }]
}
